{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  // Test files are kept out of the BUILD, not out of type checking - editors
  // and Vitest still read them. This keeps dist/ to only what the server runs,
  // and keeps the build from needing vitest resolvable on a host that
  // installed production dependencies only.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}