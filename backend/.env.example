# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/team-availability-dashboard

# Secret used to sign/verify auth JWTs
JWT_SECRET=

# Port the Express server listens on (defaults to 5000 if unset)
PORT=5000

# Origin allowed to send credentialed requests (the frontend's URL).
# Defaults to http://localhost:5173 if unset.
CORS_ORIGIN=http://localhost:5173

# Used only by src/scripts/resetAdminPassword.ts, not by the server itself
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# production disables the dev-only syncIndexes() call on boot
NODE_ENV=development
