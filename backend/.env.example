# MongoDB connection string. The database name at the end is the real local
# one - a wrong name doesn't error, it silently gives you an empty database.
MONGODB_URI=mongodb://localhost:27017/team_availability

# Secret used to sign/verify auth JWTs
JWT_SECRET=

# Port the Express server listens on (defaults to 5000 if unset).
# On Render this is set for you - don't hardcode it there.
PORT=5000

# Origin allowed to send credentialed requests (the frontend's URL).
# Defaults to http://localhost:5173 if unset. Dev only in practice: deployed,
# Express serves the frontend itself, so requests are same-origin and never
# reach CORS at all.
CORS_ORIGIN=http://localhost:5173

# Used by the two one-off scripts in src/scripts/, never by the server:
# seedAdmin.ts creates the first admin on an empty database,
# resetAdminPassword.ts changes an existing one's password.
# Set them, run the script, then delete them again - especially on a host.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional, seedAdmin.ts only - the TeamMember half of that first admin.
# Default to "Admin" and UTC; both are editable from /profile after login.
SEED_ADMIN_NAME=
SEED_ADMIN_TIMEZONE=

# production does four things: skips the dev-only syncIndexes() on boot,
# trusts one proxy hop for X-Forwarded-*, puts secure on the auth cookie,
# and serves the frontend's build from ../frontend/dist
NODE_ENV=development
